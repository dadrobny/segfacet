{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git reflog:*)",
      "Bash(git grep:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git cat-file:*)",
      "Bash(git diff-tree:*)",
      "Bash(git merge-tree:*)",
      "Bash(git check-attr:*)",
      "Bash(git pull:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python -m pip install:*)",
      "Bash(python3 -m pip install:*)",
      "Bash(python -m venv:*)",
      "Bash(python3 -m venv:*)",
      "Bash(pip install:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(python .aide/scripts/aide.py:*)",
      "Bash(python3 .aide/scripts/aide.py:*)",
      "Bash(python .claude/scripts/await_run.py:*)",
      "Bash(python3 .claude/scripts/await_run.py:*)",
      "Bash(.venv/Scripts/python:*)",
      "Bash(.venv/Scripts/pip:*)",
      "Bash(.venv/Scripts/pytest:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/pip:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(git worktree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(od:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed -n:*)",
      "Bash(diff:*)",
      "Bash(cmp:*)",
      "Bash(nl:*)",
      "Bash(sha256sum:*)",
      "Bash(md5sum:*)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(true:*)",
      "Bash(printf:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Edit(docs/aide/items/**)",
      "Write(docs/aide/items/**)",
      "Edit(docs/aide/progress.md)",
      "Write(docs/aide/queue/**)",
      "Edit(docs/aide/queue/**)",
      "Write(src/segfacet/**)",
      "Edit(src/segfacet/**)",
      "Write(tests/**)",
      "Edit(tests/**)",
      "Write(.claude/settings.local.json)",
      "Write(scripts/*.py)",
      "Write(docs/*.md)",
      "Edit(scripts/*.py)",
      "Edit(docs/*.md)",
      "Bash(awk:*)",
      "Bash(top -bn1:*)",
      "Bash(mkdir:*)",
      "Bash(.venv/bin/segfacet:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr lock:*)",
      "Bash(gh pr unlock:*)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(aide.toml)",
      "Write(aide.toml)",
      "Edit(.aide/**)",
      "Write(.aide/**)",
      "Edit(docs/aide/vision.md)",
      "Edit(docs/aide/roadmap.md)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Edit(.claude/commands/**)",
      "Write(.claude/commands/**)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"${CLAUDE_PROJECT_DIR:-.}/$1\"; [ -f \"$f\" ] || { printf \"aide: hook script not found: %s\\n\" \"$f\" >&2; exit 1; }; for py in python3 python; do command -v \"$py\" >/dev/null 2>&1 || continue; \"$py\" -c \"\" >/dev/null 2>&1 || continue; exec \"$py\" \"$f\"; done; exit 0' _ .claude/hooks/command_hygiene_guard.py"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"${CLAUDE_PROJECT_DIR:-.}/$1\"; [ -f \"$f\" ] || { printf \"aide: hook script not found: %s\\n\" \"$f\" >&2; exit 1; }; for py in python3 python; do command -v \"$py\" >/dev/null 2>&1 || continue; \"$py\" -c \"\" >/dev/null 2>&1 || continue; exec \"$py\" \"$f\"; done; exit 0' _ .claude/hooks/spawn_model_guard.py"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"${CLAUDE_PROJECT_DIR:-.}/$1\"; [ -f \"$f\" ] || { printf \"aide: hook script not found: %s\\n\" \"$f\" >&2; exit 1; }; for py in python3 python; do command -v \"$py\" >/dev/null 2>&1 || continue; \"$py\" -c \"\" >/dev/null 2>&1 || continue; exec \"$py\" \"$f\"; done; exit 0' _ .claude/hooks/log_permission_event.py"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"${CLAUDE_PROJECT_DIR:-.}/$1\"; [ -f \"$f\" ] || { printf \"aide: hook script not found: %s\\n\" \"$f\" >&2; exit 1; }; for py in python3 python; do command -v \"$py\" >/dev/null 2>&1 || continue; \"$py\" -c \"\" >/dev/null 2>&1 || continue; exec \"$py\" \"$f\"; done; exit 0' _ .claude/hooks/sibling_instructions.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"${CLAUDE_PROJECT_DIR:-.}/$1\"; [ -f \"$f\" ] || { printf \"aide: hook script not found: %s\\n\" \"$f\" >&2; exit 1; }; for py in python3 python; do command -v \"$py\" >/dev/null 2>&1 || continue; \"$py\" -c \"\" >/dev/null 2>&1 || continue; exec \"$py\" \"$f\"; done; exit 0' _ .claude/hooks/log_permission_event.py"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'f=\"${CLAUDE_PROJECT_DIR:-.}/$1\"; [ -f \"$f\" ] || { printf \"aide: hook script not found: %s\\n\" \"$f\" >&2; exit 1; }; for py in python3 python; do command -v \"$py\" >/dev/null 2>&1 || continue; \"$py\" -c \"\" >/dev/null 2>&1 || continue; exec \"$py\" \"$f\"; done; exit 0' _ .claude/hooks/log_instructions_loaded.py"
          }
        ]
      }
    ]
  }
}
