# Personal, per-machine config for AIDE. Copy this file to local.toml
# (gitignored) and edit. Nothing here is shared or committed.
#
# It holds the filesystem paths that are true of this machine and of no other,
# which is why they may not live in the committed aide.toml: [framework] names
# the framework clone itself, [hygiene] the other repos this project spans. Set
# any, all, or none.
#
# The reader is an adapter's hooks — the command-hygiene guard, where the
# adapter has one. Under a runtime whose adapter ships no such hook nothing
# reads this file, and it is then inert rather than wrong.

[framework]
# Local checkout of the aide-loop framework repo itself, for the documented
# framework-update workflow (the project's instruction file > "Updating the
# framework"). Declaring it here — not in the shared, committed aide.toml —
# gives a command-hygiene guard a narrow `git -C <local_path>` carve-out
# without putting a machine-specific filesystem path in a committed file. It
# also lets a session editing the framework clone pick up that repo's own
# instructions, which are otherwise never loaded (conventions.md §8) — the
# case this bites hardest, since the update workflow edits the framework from
# a consumer's checkout by design.
# Empty/absent = the workflow's `git -C` step stays blocked (the default,
# safe posture for anyone not actively developing the framework).
local_path = ""

[hygiene]
# Other git repos this project legitimately spans, for a command-hygiene
# guard. One project can span two repos developed together — a library and a
# sibling programme repo, say. Without a declaration the guard refuses every
# git operation against the sibling, while `git init` and plain file writes
# (both take a path argument) sail through: an agent can create the repo and
# write into it but never `add`/`commit`, leaving the work uncommitted for a
# human to finish by hand.
#
# Named for its first consumer, the guard. Listing a path here RELAXES ONE
# LINT AND GRANTS NO PERMISSION: the command still has to match the
# permission allow-list to auto-approve, and `git -C …` matches none of the
# per-subcommand rules, so it prompts. That is intended — the guard exists to
# stop shapes that would stall an unattended run, not to be a trust boundary.
#
# A declared repo is ALSO where a runtime reads that repo's own instruction
# file from, the first time a session touches a path inside it (conventions.md
# §8): a runtime loads instruction files for the working directory's repo
# only, so a sibling's rules are otherwise never in context. Declaring a repo
# here is what makes both work.
#
# Two different repos in ONE command stay blocked even when both are listed:
# history read from one repo and applied to another's working tree is a shape
# no legitimate workflow needs.
#
# Machine-specific paths, so they live here and never in the committed
# aide.toml. Empty/absent (the default) = every repo-override form blocked.
extra_repos = []
